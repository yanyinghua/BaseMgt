# BaseMgt 开发环境配置样例，复制为 .env 后按需修改

# ---- 主库（平台自身的元数据库） ----
BM_DB_HOST=127.0.0.1
BM_DB_PORT=5433
BM_DB_NAME=basemgt
BM_DB_USER=basemgt
BM_DB_PASSWORD=

# ---- Django ----
BM_SECRET_KEY=dev-secret-key-change-me
BM_DEBUG=1

# ---- 安全开关 ----
# 为 1 时关闭接口鉴权（仅建议本地开发）；为 0 时需登录后访问
BM_AUTH_DISABLED=1
# 是否允许编排中使用 python 脚本节点（可执行任意代码，生产环境建议关闭）
BM_ENABLE_SCRIPT_NODE=1
# SQL 控制台是否允许写操作（INSERT/UPDATE/DELETE）；DROP/ALTER 等 DDL 始终禁止
BM_SQL_CONSOLE_WRITE=0
# 单条 SQL 超时（毫秒）
BM_SQL_TIMEOUT_MS=30000
# 单次编排运行整体超时（秒），0 不限制
BM_RUN_TIMEOUT=0
# 异步运行：1=接口立即返回 run_id，由 worker 后台执行
BM_ASYNC_RUN=1

# ---- 前端 ----
VITE_API_BASE=http://127.0.0.1:8000
